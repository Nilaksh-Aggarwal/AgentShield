# Copy to .env.local (git-ignored) to override. Never put secrets in VITE_* variables:
# everything prefixed with VITE_ is embedded in the public JavaScript bundle.

# Base URL of the AgentShield API. Leave empty in development to use the Vite proxy (same origin).
VITE_API_BASE_URL=

# Dev-server proxy target (read by vite.config.ts only, not shipped to the browser).
VITE_API_PROXY_TARGET=http://localhost:5102

# API key the dev-server proxy adds to /api requests (vite.config.ts only; NOT a VITE_ variable, never in the bundle).
# Defaults to the API's public Development key, which the API accepts only in its Development environment.
# AGENTSHIELD_DEV_API_KEY=
