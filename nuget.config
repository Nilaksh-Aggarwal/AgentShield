<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!--
    Restore only from nuget.org. Machine-wide feeds are cleared so that builds are reproducible
    and not exposed to dependency-confusion between feeds (NU1507).
  -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget.org">
      <package pattern="*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
