{
  "stryker-config": {
    "project": "AgentShield.Infrastructure.csproj",
    "test-projects": [
      "../AgentShield.UnitTests/AgentShield.UnitTests.csproj"
    ],
    "mutate": [
      "**/Agents/InMemoryToolApprovalStore.cs",
      "**/Activity/InMemoryInputSecurityContextStore.cs"
    ],
    "coverage-analysis": "perTest",
    "reporters": [
      "progress",
      "cleartext",
      "json",
      "html"
    ],
    "thresholds": {
      "high": 90,
      "low": 75,
      "break": 0
    }
  }
}
