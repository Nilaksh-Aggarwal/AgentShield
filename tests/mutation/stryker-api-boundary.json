{
  "stryker-config": {
    "project": "AgentShield.Api.csproj",
    "test-projects": [
      "../AgentShield.ApiTests/AgentShield.ApiTests.csproj"
    ],
    "mutate": [
      "**/Auth/*.cs",
      "**/RateLimiting/*.cs"
    ],
    "coverage-analysis": "perTest",
    "reporters": [
      "progress",
      "cleartext",
      "json",
      "html"
    ],
    "thresholds": {
      "high": 90,
      "low": 75,
      "break": 0
    }
  }
}
