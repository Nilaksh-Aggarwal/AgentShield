{
  "stryker-config": {
    "project": "AgentShield.Application.csproj",
    "test-projects": ["../AgentShield.UnitTests/AgentShield.UnitTests.csproj"],
    "mutate": [
      "**/Agents/ExecuteTool/*.cs",
      "**/Abstractions/Agents/IToolArgumentPolicy.cs",
      "**/Abstractions/Agents/IToolExecutionAuthority.cs",
      "**/Activity/ToolGatewayActivityRecorder.cs",
      "**/Activity/SecurityActivityRecord.cs",
      "**/Activity/ListActivity/ListActivityUseCase.cs"
    ],
    "coverage-analysis": "perTest",
    "reporters": ["progress", "cleartext", "json", "html"],
    "thresholds": { "high": 90, "low": 75, "break": 0 }
  }
}
