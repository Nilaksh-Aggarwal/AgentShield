{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console" ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "formatter": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "Api": {
    "MaxRequestBodySizeBytes": 1048576
  },
  "Authentication": {
    "Clients": {}
  },
  "AgentAuthorization": {
    "Agents": {}
  },
  "RateLimiting": {
    "Enabled": true,
    "Firewall": {
      "PermitLimit": 60,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Standard": {
      "PermitLimit": 300,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Cors": {
    "AllowedOrigins": []
  },
  "Cache": {
    "DefaultExpiration": "00:05:00",
    "SizeLimit": 10000
  },
  "Database": {
    "CommandTimeoutSeconds": 30
  },
  "Ai": {
    "Enabled": true,
    "Provider": "Gemini",
    "Model": "gemini-3.8-flash",
    "TimeoutSeconds": 3,
    "Capacity": {
      "GlobalRequestsPerMinute": 10,
      "GlobalRequestsPerDay": 400,
      "MaxConcurrentCalls": 4,
      "GlobalInputTokensPerMinute": 200000,
      "SkipWhenDeterministicBlock": true,
      "DefaultClient": {
        "GuaranteedPerMinute": 2,
        "MaxPerMinute": 4,
        "GuaranteedPerDay": 80,
        "MaxPerDay": 160,
        "MaxConcurrentCalls": 2,
        "GuaranteedInputTokensPerMinute": 40000,
        "MaxInputTokensPerMinute": 80000,
        "WhenExceeded": "Review"
      }
    },
    "CircuitBreaker": {
      "Enabled": true,
      "FailureThreshold": 3,
      "OpenDurationSeconds": 30,
      "HalfOpenProbeTimeoutSeconds": 3
    },
    "Gemini": {
      "ApiKey": ""
    }
  },
  "ConnectionStrings": {
    "AgentShield": ""
  }
}
