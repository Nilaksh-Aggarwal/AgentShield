{
  "Serilog": {
    "Using": [ "Serilog.Sinks.Console", "Serilog.Sinks.File" ],
    "MinimumLevel": {
      "Default": "Debug",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.Hosting.Lifetime": "Information",
        "Microsoft.EntityFrameworkCore": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] [{CorrelationId}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/agentshield-.json",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "formatter": "Serilog.Formatting.Compact.CompactJsonFormatter, Serilog.Formatting.Compact"
        }
      }
    ]
  },
  "Authentication": {
    "Clients": {
      "development": {
        "KeyHashes": [ "a6fe8444310e70027e4344a24208dd445e74f38c4d0ccff50aa3edffae3b59cc" ],
        "Permissions": [ "firewall:analyze", "activity:read", "agent:authorize", "tool:execute", "agent:approve" ]
      }
    }
  },
  "AgentAuthorization": {
    "Agents": {
      "support-agent": {
        "Capabilities": [ "data:read", "email:read", "email:draft", "email:send" ],
        "Clients": [ "development" ]
      },
      "research-agent": {
        "Capabilities": [ "data:read", "file:read", "browser:navigate", "knowledge:read" ],
        "Clients": [ "development" ],
        "GatewayClient": "development"
      },
      "operations-agent": {
        "Capabilities": [ "data:read", "data:write", "file:read", "file:write" ],
        "Clients": [ "development" ]
      },
      "finance-agent": {
        "Capabilities": [ "data:read", "payment:execute" ],
        "Clients": [ "development" ]
      }
    }
  },
  "RateLimiting": {
    "Enabled": true,
    "Firewall": {
      "PermitLimit": 600,
      "WindowSeconds": 60,
      "QueueLimit": 0
    },
    "Standard": {
      "PermitLimit": 3000,
      "WindowSeconds": 60,
      "QueueLimit": 0
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:5173" ]
  },
  "Ai": {
    "Enabled": true,
    "Provider": "Gemini",
    "Model": "gemini-3.8-flash",
    "TimeoutSeconds": 3,
    "Capacity": {
      "GlobalRequestsPerMinute": 10,
      "GlobalRequestsPerDay": 400,
      "MaxConcurrentCalls": 4,
      "GlobalInputTokensPerMinute": 200000,
      "SkipWhenDeterministicBlock": true,
      "DefaultClient": {
        "GuaranteedPerMinute": 2,
        "MaxPerMinute": 4,
        "GuaranteedPerDay": 80,
        "MaxPerDay": 160,
        "MaxConcurrentCalls": 2,
        "GuaranteedInputTokensPerMinute": 40000,
        "MaxInputTokensPerMinute": 80000,
        "WhenExceeded": "Review"
      }
    },
    "CircuitBreaker": {
      "Enabled": true,
      "FailureThreshold": 3,
      "OpenDurationSeconds": 30,
      "HalfOpenProbeTimeoutSeconds": 3
    },
    "Gemini": {
      "ApiKey": ""
    }
  }
}
