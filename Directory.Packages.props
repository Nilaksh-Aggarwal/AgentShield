<Project>

  <!--
    Central Package Management: every NuGet version lives here, csproj files reference packages without versions.
    Before adding a package, follow CLAUDE.md "Package rules" and record why it exists (comment below + docs).
  -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>

  <ItemGroup Label="Composition / DI">
    <!-- Convention-based assembly scanning on top of Microsoft.Extensions.DependencyInjection. -->
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Configuration.Abstractions" Version="10.0.12" />
    <PackageVersion Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="Application">
    <!-- Request validation rules (validators live in Application, executed by the API validation filter). -->
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup Label="Infrastructure">
    <!-- PostgreSQL provider for EF Core (brings Microsoft.EntityFrameworkCore). -->
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- AddDbContextCheck<T>() for the readiness probe. -->
    <PackageVersion Include="Microsoft.Extensions.Diagnostics.HealthChecks.EntityFrameworkCore" Version="10.0.12" />
    <!-- IMemoryCache behind ICacheService. -->
    <PackageVersion Include="Microsoft.Extensions.Caching.Memory" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="AI">
    <!--
      Official Google Gen AI SDK for .NET (github.com/googleapis/dotnet-genai), used only by the Gemini adapter in
      AgentShield.AI. Not the deprecated Google.Ai.Generativelanguage / community "GoogleGenerativeAI" packages.
    -->
    <PackageVersion Include="Google.GenAI" Version="1.22.0" />
    <!-- IHttpClientFactory typed clients (AddHttpClient) for AI provider adapters. -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.12" />
  </ItemGroup>

  <ItemGroup Label="API">
    <!-- Structured logging (brings Serilog, Settings.Configuration, Console/File sinks, request logging). -->
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <!-- OpenAPI document generation + Swagger UI (intentionally Swashbuckle, not Scalar). -->
    <PackageVersion Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <!-- In-memory hosting of the API (WebApplicationFactory) for ApiTests / IntegrationTests. -->
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.12" />
  </ItemGroup>

</Project>
